# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# ── Docker Compose (app + database) ───────────────────────────────────────────
# Read by docker-compose.yml. Both are required for `docker-compose up`.
DB_PASSWORD=changeme
JWT_SHARED_SECRET=change-me-to-a-long-random-string

# ── Analytics ETL pipeline (analytics/etl) ────────────────────────────────────
# Use the same password as DB_PASSWORD.
# Running the pipeline on the host: Postgres is published on port 8100.
PAYSPRINT_SOURCE_DB_URL=postgresql://paysprint:changeme@localhost:8100/paysprint
PAYSPRINT_ANALYTICS_DB_URL=postgresql://paysprint:changeme@localhost:8100/paysprint_analytics

# Running it inside the Compose network: use the service name and internal port.
# PAYSPRINT_SOURCE_DB_URL=postgresql://paysprint:changeme@db:5432/paysprint
# PAYSPRINT_ANALYTICS_DB_URL=postgresql://paysprint:changeme@db:5432/paysprint_analytics

# Optional ETL settings, shown with their defaults.
# ETL_INTERVAL_SECONDS=600      # how often the etl service in docker-compose refreshes P&L
# ETL_LOOKBACK_DAYS=            # unset = full trade history, which FIFO P&L needs
# BATCH_SIZE=1000
# MAX_RETRIES=12
# RETRY_DELAY_SECONDS=5
# LOG_LEVEL=INFO
# LOG_FILE=analytics/etl/etl.log

# ── AI trade analysis (com.neueda.leap.analysis) ──────────────────────────────
# docker-compose passes these to the app for POST /api/trades/{tradeId}/analysis.
# OpenAiTradeAnalyzerLiveTest also reads them and is skipped while the key is empty.
# Maven does not load .env, so pass them in:
#   env $(grep -E '^OPENAI_' .env | xargs) mvn -B test -Dtest=OpenAiTradeAnalyzerLiveTest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
