# Analytics ETL Pipeline Configuration
# Copy this file to .env and fill in actual values

# Database connection URLs (PostgreSQL format)
# Source database: paysprint (OLTP)
PAYSPRINT_SOURCE_DB_URL=postgresql://paysprint:changeme@localhost:5432/paysprint

# Target database: paysprint_analytics (OLAP/Staging)
PAYSPRINT_ANALYTICS_DB_URL=postgresql://paysprint:changeme@localhost:5432/paysprint_analytics

# For Docker environments, replace localhost with 'db' (service name)
# PAYSPRINT_SOURCE_DB_URL=postgresql://paysprint:changeme@db:5432/paysprint
# PAYSPRINT_ANALYTICS_DB_URL=postgresql://paysprint:changeme@db:5432/paysprint_analytics
