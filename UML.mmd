classDiagram
    direction TB

    class PII {
        -user_id UUID
        -first_name String
        -last_name String
        -DOB Date
        -SSN String
        -email String
        -phone_number String
        -address String
        +getAge() int
        +isAdult() Boolean
    }

    class IUser {
        <<interface>>
        -user_id UUID
        -role Enum
        -status Enum
        -getDto() UserDto
    }

    class ClientUser {

    }

    class AnalystUser {

    }

    class AdminUser {

    }

    class Account {
        -account_id UUID
        -user_id UUID
        -status Enum
        -currency String
        -balance double
        -created_at Date
    }

    class Instrument {
        -instrument_id UUID
        -ticker String
        -name String
        -type String
        -exchange_id UUID
        -current_price double
        -updated_at Date
    }

    class Exchange {
        -exchange_id UUID
        -name String
        -region String
        -timezone String
        -currency String
        +isMarketOpen() Boolean
        
    }

    class Holding {
        -account_id UUID
        -instrument_id UUID
        -quantity double
        +getValue(currentPrice double) double
        
    }

    class Trade {
        -trade_id UUID
        -account_id UUID
        -instrument_id UUID
        -side Enum
        -status Enum
        -quantity double
        -execution_price double
        -executed_at Timestamp
        +getTradeValue() double
        +getStatus() Enum
    }

    class Request {   

    }

    class Response {
        -success Boolean
        -message String
        +toString() String
    }

    class BuyRequest {
        -account_id UUID
        -instrument_id UUID
        -quantity double
        -hasSufficentBalance Boolean
    }

    class SellRequest {
    }

    class Service {

    }

    class TransactionService {

    }


    ClientUser --|> IUser : inheritance
    AnalystUser --|> IUser : inheritance
    AdminUser --|> IUser : inheritance
    BuyRequest --|> Request : inheritance
    SellRequest --|> Request : inheritance